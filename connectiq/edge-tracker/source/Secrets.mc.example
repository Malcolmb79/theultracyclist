import Toybox.Lang;

//! Copy this file to Secrets.mc (gitignored) and fill in the real value.
//!
//! Application.Properties (Connect IQ's usual settings mechanism) turned
//! out to be unreachable for this app: both Garmin Connect Mobile and
//! Garmin Express only show a settings UI for apps with Connect IQ Store
//! metadata behind their App ID - a purely local, never-published sideload
//! like this one has none, so there is no on-device or companion-app way
//! to enter a value into it at all. Baking the token in at compile time is
//! the pragmatic alternative for an app that will never be published -
//! same "never commit the real secret" reasoning as developer_key.der,
//! just via a gitignored source file instead of a build flag.
module Secrets {
    const INGEST_TOKEN = "";
}
