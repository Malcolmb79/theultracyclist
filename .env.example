# Required by api/strava-activities.ts. Set the real values in Vercel
# (Project Settings -> Environment Variables) and, for local `vercel dev`,
# in a git-ignored .env.local — never commit actual secrets here.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Required by api/whoop-data.ts, api/whoop-authorize.ts, and
# api/whoop-callback.ts. WHOOP_CLIENT_ID/SECRET come from a Whoop developer
# app at developer.whoop.com. WHOOP_REFRESH_TOKEN is only a one-time seed -
# once signed in, go to Settings and click "Reconnect Whoop" to authorize
# via Whoop's OAuth screen; the resulting refresh token is stored in Redis
# (see REDIS_URL below) and self-rotates from there with no redeploy
# involved, so it can't get orphaned by a redeploy race the way the old
# env-var mechanism could. WHOOP_REDIRECT_URI must exactly match a redirect
# URI registered on that Whoop app, e.g.
# https://theultracyclist.com/api/whoop-callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_REFRESH_TOKEN=

# Used by api/health-data.ts to self-persist pushed Apple Health data back
# into this Vercel project's env vars (api/whoop-data.ts's own token
# storage moved to Redis - see REDIS_URL below - so it no longer needs
# these).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Required for instant (no-redeploy) persistence: dashboard/trends/coaching
# layout and settings saves, and the Whoop refresh token, all live in Redis
# via this connection string - provision via Vercel's "Redis" marketplace
# storage integration, which sets this automatically.
REDIS_URL=

# Required by api/health-data.ts. APPLE_HEALTH_WEBHOOK_SECRET authenticates
# POSTs from an iOS Shortcut; APPLE_HEALTH_HISTORY starts as "[]" and is
# updated in place by the webhook.
APPLE_HEALTH_WEBHOOK_SECRET=
APPLE_HEALTH_HISTORY=[]

# Optional: a Vercel Deploy Hook URL (Project Settings -> Git -> Deploy Hooks).
# When set, api/health-data.ts triggers a redeploy after a save so pushed
# Apple Health data shows up without waiting for the next code change.
# (dashboard-layout.ts, trends-layout.ts, trends-goals.ts, and
# coaching-settings.ts used to depend on this too, but now save instantly to
# Redis instead - see REDIS_URL above.)
HEALTH_DATA_DEPLOY_HOOK_URL=

# Required by api/dashboard-layout.ts, api/trends-layout.ts,
# api/trends-goals.ts, api/coaching-settings.ts, and api/coaching-narrative.ts
# (session cookie check across the dashboard, trends, and coaching pages -
# see the Microsoft sign-in block below for how the session gets created).
DASHBOARD_LAYOUT=[]

# Microsoft sign-in (Entra ID / M365), used by api/auth-login.ts,
# api/auth-callback.ts, api/auth-session.ts, and api/_lib/session.ts.
# Replaces the old shared-password gate entirely.
#
# AZURE_CLIENT_ID / AZURE_CLIENT_SECRET come from an Entra ID app
# registration you create yourself at entra.microsoft.com -> App
# registrations -> New registration (a security-setting change in your
# Microsoft identity tenant, so it's done directly in the Azure/Entra
# portal, not automated here). Supported account types: "Accounts in any
# organizational directory and personal Microsoft accounts". Add a Web
# platform redirect URI matching AZURE_REDIRECT_URI below, then create a
# client secret under Certificates & secrets.
# AZURE_REDIRECT_URI must exactly match the redirect URI configured on that
# app registration, e.g. https://theultracyclist.com/api/auth-callback
# SESSION_SECRET is a random secret used to sign the session cookie once
# Microsoft sign-in succeeds - generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ALLOWED_M365_EMAILS is a comma-separated allowlist of the Microsoft
# account email(s) permitted to sign in - anyone else who signs in with
# Microsoft is denied even though the app itself accepts any Microsoft
# account (work/school or personal).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
SESSION_SECRET=
ALLOWED_M365_EMAILS=

# Required by api/trends-layout.ts and api/trends-goals.ts.
TRENDS_LAYOUT=[]
PERFORMANCE_GOALS={}

# Required by api/coaching-settings.ts (FTP, weekly targets, training phase).
COACHING_SETTINGS={}

# Optional, required only by api/coaching-narrative.ts. Without it, the
# Coaching page's AI note card shows a "not configured" message and
# everything else on the page still works. Needs its own Anthropic API key
# with billing on your own account - this is a separate credential from
# whatever assistant you're using to develop this project.
ANTHROPIC_API_KEY=

# Required by api/whatsapp-webhook.ts - lets you WhatsApp the AI coach
# directly instead of only through the Coaching page's chat card. Uses
# ANTHROPIC_API_KEY above for the actual replies.
#
# 1. Create a free Twilio account at twilio.com, then open Messaging ->
#    Try it out -> Send a WhatsApp message (the WhatsApp Sandbox).
# 2. TWILIO_AUTH_TOKEN is on the main Twilio Console dashboard - only the
#    auth token is needed here (not the Account SID), since replies go back
#    via TwiML in the webhook response rather than a separate outbound API
#    call.
# 3. In the sandbox settings, set "When a message comes in" to
#    https://theultracyclist.com/api/whatsapp-webhook (POST).
# 4. From your own phone, WhatsApp the sandbox number the join code shown
#    on that page (e.g. "join happy-tiger") - this is a one-time step per
#    sandbox, not needed again after.
# 5. COACH_WHATSAPP_ALLOWED_NUMBERS is a comma-separated allow-list of the
#    WhatsApp number(s) permitted to talk to the coach (E.164 format, e.g.
#    +353851234567 - no "whatsapp:" prefix). Anyone else who messages the
#    sandbox is silently ignored, same as ALLOWED_M365_EMAILS above.
#
# Texting "checkin" (or "check in"/"check-in"/"template"/"checkin template")
# replies with the fixed physique check-in template (CHECKIN_TEMPLATE in
# whatsapp-webhook.ts) verbatim instead of going through the AI - a plain
# string match rather than an AI-recalled template, so the format never
# drifts across replies.
TWILIO_AUTH_TOKEN=
COACH_WHATSAPP_ALLOWED_NUMBERS=
