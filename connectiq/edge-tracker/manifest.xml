<?xml version="1.0"?>
<!--
  Communications is the one permission this app actually needs - it POSTs
  batches of samples to api/ingest.ts over HTTPS. Everything else stays as
  minimal as visibility-test's manifest (see that project's own comment for
  why: fewer permissions is fewer install prompts and fewer things that can
  fail for a reason unrelated to what's being tested).
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="4c6ca7f9ed249a44f099baf70ab23eba"
        type="datafield"
        name="@Strings.AppName"
        entry="EdgeTrackerApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.1.0">
        <iq:products>
            <iq:product id="edge1040"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
